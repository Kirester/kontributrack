# KontribuTrack - Environment Variables Configuration Template
# Copy this file to .env and fill in your actual credentials.

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=kontributrack

# Server & Session Configuration
PORT=3000
SESSION_SECRET=your_super_secret_session_key_here

# App Base URL for QR Code generation (Set your Wi-Fi IP or Cloudflare Tunnel URL)
# If left blank, KontribuTrack automatically detects your computer's local Wi-Fi IP!
# APP_URL=https://your-tunnel.trycloudflare.com

# iProgSMS Gateway Integration
# Obtain your API Token from https://sms.iprogtech.com/ (My Profile -> API Tokens)
IPROG_SMS_API_TOKEN=your_iprogsms_api_token_here
